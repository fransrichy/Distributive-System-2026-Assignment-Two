import ballerina/http;

type MenuItem record {|
    string itemId;
    string name;
    decimal price;
    int quantity;
|};

MenuItem[] menu = [];

service /restaurant on new http:Listener(8081) {

    resource function post menu(MenuItem item) returns MenuItem {
        menu.push(item);
        return item;
    }

    resource function get menu() returns MenuItem[] {
        return menu;
    }
}
