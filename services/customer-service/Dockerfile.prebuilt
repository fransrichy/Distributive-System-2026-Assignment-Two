# Fast local image: packages the JAR already produced by `bal build` on the host
# (used by docker-compose.prebuilt.yml on low-spec machines). The default Dockerfile
# compiles inside Docker and needs no local Ballerina installation.
FROM eclipse-temurin:21-jre
RUN useradd --system --uid 10001 --home /app app
WORKDIR /app
COPY target/bin/*.jar ./app.jar
COPY Config.toml ./Config.toml
USER app
ENV HTTP_PORT=8081 JAVA_OPTS="-XX:+UseSerialGC -Xms48m -Xmx192m -Xss512k -XX:TieredStopAtLevel=1 -XX:ReservedCodeCacheSize=48m"
EXPOSE 8081 9797
HEALTHCHECK --interval=15s --timeout=5s --start-period=60s --retries=5 CMD bash -c 'exec 3<>/dev/tcp/127.0.0.1/$HTTP_PORT && printf "GET /health HTTP/1.0\r\n\r\n" >&3 && head -1 <&3 | grep -q " 200 "'
ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar app.jar"]
